; Engine configuration file.
; Football Dynasty — production career shell
config_version=5

[application]
config/name="Football Dynasty"
config/version="1.0.0-rc3"
config/unique_name="com.footballdynasty.game"
run/main_scene="res://game/scenes/career_app.tscn"
config/features=PackedStringArray("4.7")

[autoload]
PolishRuntime="*res://game/polish/polish_runtime_compat.gd"
CompletionRuntime="*res://game/polish/completion_runtime_compat.gd"
TacticsRuntime="*res://game/polish/tactics_runtime.gd"
SearchRuntime="*res://game/polish/search_runtime_compat.gd"
MatchHudRuntime="*res://game/polish/match_hud_runtime.gd"
ManagementRuntime="*res://game/polish/management_runtime_compat.gd"
CareerControlsRuntime="*res://game/polish/career_controls_runtime.gd"
GraphicsRuntime="*res://game/polish/graphics_runtime.gd"
SquadRuntime="*res://game/polish/squad_runtime.gd"
AutosaveRuntime="*res://game/polish/autosave_runtime.gd"
DashboardRuntime="*res://game/polish/dashboard_runtime.gd"
NavigationRuntime="*res://game/polish/navigation_runtime_compat.gd"
TrainingRuntime="*res://game/polish/training_runtime.gd"
HappinessRuntime="*res://game/polish/happiness_runtime.gd"
UIReadabilityRuntime="*res://game/polish/ui_readability_runtime.gd"
PresentationRuntime="*res://game/polish/presentation_runtime.gd"
CompositionRuntime="*res://game/polish/composition_runtime.gd"
ArtDirectionRuntime="*res://game/polish/art_direction_runtime.gd"
UI2Runtime="*res://game/polish/ui2_runtime_compat.gd"
UI2ExtendedRuntime="*res://game/polish/ui2_extended_runtime_compat.gd"
UI2MatchdayRuntime="*res://game/polish/ui2_matchday_runtime.gd"
UI2ProfileRuntime="*res://game/polish/ui2_profile_runtime.gd"
UI2IntegrationRuntime="*res://game/polish/ui2_integration_runtime_compat.gd"
UI2RemainingRuntime="*res://game/polish/ui2_remaining_runtime_compat.gd"
UI2LayoutFixRuntime="*res://game/polish/ui2_layout_fix_runtime.gd"
UI2MenuRuntime="*res://game/polish/ui2_menu_runtime.gd"
PlaytestControlsRuntime="*res://game/polish/playtest_controls_runtime.gd"
BackgroundSaveRuntime="*res://game/polish/background_save_runtime.gd"
AudioSettingsRuntime="*res://game/polish/audio_settings_runtime.gd"
PlaytestDepthRuntime="*res://game/polish/playtest_depth_runtime.gd"
PlaytestUIFixesRuntime="*res://game/polish/playtest_ui_fixes_runtime.gd"
DynamicsResponsivenessRuntime="*res://game/polish/dynamics_responsiveness_runtime.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"
window/dpi/allow_hidpi=true

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

environment/defaults/default_clear_color=Color(0.018, 0.030, 0.058, 1)
